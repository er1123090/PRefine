  "GetRestaurants": [
    {
      "query_id": "GetRestaurants",
      "query": [
        {
          "role": "User",
          "message": "I want to find a nice to-go meal. Any suggestions?"
        },
        {
          "role": "Assistant",
          "message": "Sure. What city should I search in?",
          "service": [
            "GetRestaurants(category=\"Take-out\")"
          ]
        },
        {
          "role": "User",
          "message": "Vallejo."
        },
        {
          "role": "Assistant",
          "message": "Alright. Are you looking to get food on a specific date?"
        },
        {
          "role": "User",
          "message": "Yes, on March 5th."
        },
        {
          "role": "Assistant",
          "message": "Got it. Do you have a time in mind?"
        },
        {
          "role": "User",
          "message": "Around 6:15 in the evening."
        }
      ],
      "api_call": [
        "GetRestaurants(city=\"Vallejo\", date=\"2019-03-05\", time=\"18:15\")"
      ],
      "target": [
        {
          "domain": "GetRestaurants",
          "slot": "price_range",
          "value": [
            "cheap"
          ]
        }
      ]
    }
  ],
