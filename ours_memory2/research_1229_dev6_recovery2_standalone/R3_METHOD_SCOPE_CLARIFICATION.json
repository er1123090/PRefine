  "clarification_authority": {
    "purpose": "resolve_the_literal_tension_between_required_generate_verify_refine_and_the_ban_on_using_current_run_outputs_to_construct_another_call",
    "effect": "narrow_interpretation_only",
    "may_relax_information_firewall": false,
