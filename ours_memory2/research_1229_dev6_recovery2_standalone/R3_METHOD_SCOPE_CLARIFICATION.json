      "attempt_budget_exhausted_last_draft_to_next_history_session_prior_memory_with_candidate_transfer_kept_fail_closed_by_invalid_attestation"
    ],
    "frozen_call_graph": "for_each_history_session_attempt_0_generate_then_verify;on_exact_valid_true_accept_and_advance;otherwise_attempt_1_through_9_refine_then_verify;after_attempt_9_stop_and_advance_with_the_last_draft_under_the_frozen_attestation_policy",
    "maximum_generation_slots_per_history_session": 10,
    "generation": {
      "temperature": 0.4,
      "maximum_tokens": 2048,
      "json_object": true,
      "seed_schedule": "base_seed_plus_session_index_times_100_plus_attempt_index_times_2"
    },
    "verification": {
      "temperature": 0.0,
      "maximum_tokens": 512,
      "json_object": true,
      "seed_schedule": "base_seed_plus_session_index_times_100_plus_attempt_index_times_2_plus_1"
    },
    "stop_rule": "exact_JSON_boolean_valid_true_or_frozen_attempt_budget_exhaustion",
    "justification_for_ten_slots": "source_faithful_standalone_ours_memory2_MAX_GENERATION_SLOTS_10_frozen_without_held_out_query_gold_target_output_or_metric;the_paper_reports_three_as_the_main_experiment_cap_and_ten_as_a_target_free_appendix_sensitivity_setting_with_no_consistent_gain",
    "prompt_and_schema_identity": "hash_bound_by_the_final_implementation_manifest_and_pre_gold_commitment_before_gold_open"
  },
  "forbidden_feedback_edges": [
