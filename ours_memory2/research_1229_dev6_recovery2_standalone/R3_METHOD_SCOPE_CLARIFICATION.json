    "may_change_original_rubric_bytes": false,
    "may_authorize_a_second_final_attempt": false
  },
  "history_only_generate_verify_refine": {
    "inputs": [
      "sanitized_chronological_history_dialogue",
      "sanitized_chronological_history_api_calls",
      "prior_session_accepted_memory",
      "frozen_generation_or_refinement_prompt",
      "frozen_verifier_prompt"
    ],
    "allowed_causal_edges": [
      "generator_draft_to_frozen_verifier_prompt_candidate_field",
      "verifier_feedback_to_frozen_refinement_prompt_feedback_field",
      "accepted_verified_memory_to_next_history_session_prior_memory_field",
