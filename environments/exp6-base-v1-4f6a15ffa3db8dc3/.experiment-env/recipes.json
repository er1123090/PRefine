  "recipes": {
    "smoke_snapshot_eval6": {
      "description": "Verify the sealed exp6 snapshot can execute while writing only to the experiments7 run directory.",
      "command": [
        "{python}",
        "-c",
        "import os,pathlib; p=pathlib.Path(os.environ['EXPERIMENT_RUN_DIR'])/'smoke.txt'; p.write_text('ok\\n', encoding='utf-8')"
      ],
      "default_args": [],
      "output_flags": [],
      "required_output_flags": []
    },
    "preference_memory_singleturn_api_eval6": {
      "description": "Experiments6 preference-memory single-turn API inference (eval6 semantics).",
      "command": ["scripts/run_preference_memory_singleturn_api.sh"],
      "default_args": [
        "--memory_path", "{run_dir}/memory.jsonl",
        "--pref_type", "easy",
        "--context_type", "memory_api",
        "--output_path", "{run_dir}/output.json",
        "--log_path", "{run_dir}/run.log"
      ],
      "output_flags": ["--output_path", "--log_path"],
      "required_output_flags": ["--output_path", "--log_path"]
    },
